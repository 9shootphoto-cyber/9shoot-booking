# Google Calendar OAuth（選填，未設定則預約不會寫入日曆）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_CALENDAR_ID=primary

# Telegram 通知（預設讀取 Mavis 現有憑證，通常唔使改）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=6687684829

# Server
PORT=3000

# ===== 自動回覆（選填）=====
# WhatsApp 唔需要設定，用 wa.me 免費連結（config.json 的 brand.whatsapp）
# 客人提交表單後，頁面會開 WhatsApp 並帶住預約資料，客人一撳就 send

# Email 自動發送（Gmail 做法：開啟 2FA → 生成 App Password）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=9shootphoto@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=9Shoot Photo Studio <9shootphoto@gmail.com>

# SMS 自動發送（Twilio）
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_FROM=+853xxxxxxx
